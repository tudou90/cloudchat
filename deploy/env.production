# /opt/cloudchat/.env — production settings (chmod 600, owned by cloudchat)

# Listen only on localhost; Caddy/nginx is the public entry point.
SERVER_ADDR=127.0.0.1:8080

# Your public HTTPS origin. Enables secure cookies, HSTS, correct canonical
# URLs, social previews and the sitemap.
PUBLIC_URL=https://chat.example.com

# The reverse proxy on this machine, so rate limits see real client IPs.
TRUSTED_PROXIES=127.0.0.1,::1

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=CHANGE_ME_TO_THE_SAME_PASSWORD_AS_REDIS_CONF
REDIS_DB=0

# Below Redis maxmemory (1536mb in deploy/redis.conf).
STORAGE_LIMIT_MB=1024
# Pause file uploads (only) at this much Redis memory, so chat keeps working
# even if someone fills file storage (MB; must not exceed STORAGE_LIMIT_MB)
FILE_STORAGE_LIMIT_MB=600
# Most chat rooms that can exist at once on the whole platform (0 = unlimited).
# New rooms are refused beyond it; see them with `cloudchat admin room list`.
MAX_ROOMS=0

RATE_LIMIT=true
ROOM_TTL=24h
EMPTY_ROOM_TTL=5m
HISTORY_LIMIT=200
HISTORY_FOR_NEW_MEMBERS=false
ALLOWED_ORIGINS=

# Legal details shown on /terms and /privacy (highlighted placeholders if empty)
OPERATOR_NAME=
# Optional postal address (required once you register a DMCA agent)
OPERATOR_ADDRESS=
CONTACT_EMAIL=
GOVERNING_STATE=
# Must match how long you actually keep logs (see deploy/README.md, journald)
LOG_RETENTION_DAYS=7

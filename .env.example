# CloudChat configuration. Copy to .env and adjust.
# Real environment variables override values in this file.

# HTTP listen address
SERVER_ADDR=:8080

# Public origin of the site, used for canonical URLs, social previews and the
# sitemap (e.g. https://chat.example.com). Leave empty to use the request host.
PUBLIC_URL=

# Redis connection
REDIS_ADDR=localhost:6389
REDIS_PASSWORD=
REDIS_DB=0

# How long an idle room stays joinable (Go duration: 30m, 2h, 24h...)
ROOM_TTL=24h

# How long a room and its messages/files survive after everyone has left
# (covers page reloads; must be between 1s and ROOM_TTL)
EMPTY_ROOM_TTL=5m

# Recent messages kept per room and replayed on (re)join; 0 = keep none
HISTORY_LIMIT=200

# Whether people joining a room see messages sent before they first joined.
# Either way, people who refresh or rejoin see everything since their first join.
HISTORY_FOR_NEW_MEMBERS=false

# Abuse protection. Per-client request limits (keep on in production).
RATE_LIMIT=true
# Reverse proxies (IPs/CIDRs, comma-separated) allowed to set X-Forwarded-For,
# e.g. 127.0.0.1 when behind nginx on the same host. Empty = trust none.
TRUSTED_PROXIES=
# Refuse new rooms/files/secrets once Redis uses this much memory (MB; 0 = off)
STORAGE_LIMIT_MB=384
# Where shared files are stored on disk; Redis keeps only their metadata.
# Files are deleted from disk when their room is (checked every
# FILE_SWEEP_INTERVAL).
FILE_STORAGE_DIR=./data/files
# Pause file uploads (only) once files on disk take this much space (MB; 0 = off)
FILE_STORAGE_LIMIT_MB=2048
FILE_SWEEP_INTERVAL=30s
# Daily usage totals (visitors, rooms, messages, files...) are archived here,
# one JSON line per day; see them with `cloudchat admin stats`. Nothing
# personal is stored. Set to "off" to record no statistics at all.
STATS_FILE=./data/stats.jsonl
# Most chat rooms that can exist at once on the whole platform (0 = unlimited).
# New rooms are refused beyond it; see them with `cloudchat admin room list`.
MAX_ROOMS=0

# Extra origins allowed to open WebSockets, comma-separated ("*" = any).
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=

# Legal details shown on /terms and /privacy (highlighted placeholders if empty)
OPERATOR_NAME=
# Optional postal address (required once you register a DMCA agent)
OPERATOR_NAME=Yddbgx
OPERATOR_ADDRESS=
CONTACT_EMAIL=contact@yddbgx.com
# Must match how long you actually keep logs (see deploy/README.md, journald)
LOG_RETENTION_DAYS=7
